@using System.Globalization
@model LibraryManagement.ViewModels.EmployeeFormViewModel
@{
    var isEnglish = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en";
    ViewData["Title"] = isEnglish ? "Add employee" : "Thêm nhân viên";
}

<h2>@ViewData["Title"]</h2>

<form asp-action="Create" method="post" class="row g-3">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="col-md-6">
        <label asp-for="FullName" class="form-label">@(isEnglish ? "Full name" : "Họ tên")</label>
        <input asp-for="FullName" class="form-control" />
        <span asp-validation-for="FullName" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Email" class="form-label">Email</label>
        <input asp-for="Email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="RoleId" class="form-label">@(isEnglish ? "Role" : "Vai trò")</label>
        <select asp-for="RoleId" asp-items="ViewBag.Roles" class="form-select">
            <option value="">@(isEnglish ? "-- Select role --" : "-- Chọn vai trò --")</option>
        </select>
        <span asp-validation-for="RoleId" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Password" class="form-label">@(isEnglish ? "Password" : "Mật khẩu")</label>
        <input asp-for="Password" class="form-control" />
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <div class="form-check mt-2">
            <input asp-for="IsActive" class="form-check-input" />
            <label asp-for="IsActive" class="form-check-label">@(isEnglish ? "Active" : "Hoạt động")</label>
        </div>
    </div>

    <div class="col-12 d-flex gap-2">
        <button class="btn btn-primary">@(isEnglish ? "Save" : "Lưu")</button>
        <a asp-action="Index" class="btn btn-outline-secondary">@(isEnglish ? "Back" : "Quay lại")</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
