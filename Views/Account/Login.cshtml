@using System.Globalization
@model LibraryManagement.ViewModels.LoginViewModel
@{
    var isEnglish = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en";
    ViewData["Title"] = isEnglish ? "Login" : "Đăng nhập";
}

<div class="row justify-content-center align-items-center auth-wrap">
    <div class="col-md-5">
        <div class="card auth-card">
            <div class="card-body">
                <p class="hero-kicker text-success mb-2">@(isEnglish ? "Welcome back" : "Chào mừng quay lại")</p>
                <h3 class="mb-3">@(isEnglish ? "Sign in to the system" : "Đăng nhập hệ thống")</h3>
                <form asp-action="Login" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <input asp-for="Email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@(isEnglish ? "Password" : "Mật khẩu")</label>
                        <input asp-for="Password" class="form-control" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>
                    <div class="form-check mb-3">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label class="form-check-label">@(isEnglish ? "Remember me" : "Ghi nhớ đăng nhập")</label>
                    </div>
                    <button class="btn btn-primary w-100">@(isEnglish ? "Login" : "Đăng nhập")</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
