@using System.Globalization
@model LibraryManagement.Models.Author
@{
    var isEnglish = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en";
    ViewData["Title"] = isEnglish ? "Delete author" : "Xóa tác giả";
}

<h2>@ViewData["Title"]</h2>
<p>@(isEnglish ? "Are you sure you want to delete this author?" : "Bạn có chắc muốn xóa tác giả này?")</p>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button class="btn btn-danger">@(isEnglish ? "Delete" : "Xóa")</button>
    <a asp-action="Index" class="btn btn-outline-secondary">@(isEnglish ? "Cancel" : "Hủy")</a>
</form>
