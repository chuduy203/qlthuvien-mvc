@using System.Globalization
@model IEnumerable<LibraryManagement.Models.Author>
@{
    var isEnglish = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en";
    ViewData["Title"] = isEnglish ? "Authors" : "Quản lý tác giả";
}

<h2>@ViewData["Title"]</h2>
<a asp-action="Create" class="btn btn-primary mb-3">@(isEnglish ? "Add" : "Thêm")</a>

<div class="table-responsive">
    <table class="table table-bordered table-hover">
        <thead>
        <tr>
            <th>ID</th>
            <th>@(isEnglish ? "Author name" : "Tên tác giả")</th>
            <th>@(isEnglish ? "Actions" : "Thao tác")</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var x in Model)
        {
            <tr>
                <td>@x.Id</td>
                <td>@x.AuthorName</td>
                <td class="d-flex gap-1">
                    <a asp-action="Edit" asp-route-id="@x.Id" class="btn btn-sm btn-warning">@(isEnglish ? "Edit" : "Sửa")</a>
                    <a asp-action="Delete" asp-route-id="@x.Id" class="btn btn-sm btn-danger">@(isEnglish ? "Delete" : "Xóa")</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
