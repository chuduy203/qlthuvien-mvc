@using System.Globalization
@model LibraryManagement.Models.Category
@{
    var isEnglish = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en";
    ViewData["Title"] = isEnglish ? "Delete category" : "Xóa thể loại";
}

<h2>@ViewData["Title"]</h2>
<p>@(isEnglish ? "Are you sure you want to delete this category?" : "Bạn có chắc muốn xóa thể loại này?")</p>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button class="btn btn-danger">@(isEnglish ? "Delete" : "Xóa")</button>
    <a asp-action="Index" class="btn btn-outline-secondary">@(isEnglish ? "Cancel" : "Hủy")</a>
</form>
